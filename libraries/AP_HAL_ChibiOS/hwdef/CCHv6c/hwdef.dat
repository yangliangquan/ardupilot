# hw definition file for processing by chibios_hwdef.py
# for the CCH-v6c hardware (WCH CH32H417, Pixhawk v6C-compatible layout)
#
# NOTE: the application firmware runs from external QSPI flash
# (Winbond, treated as 4MB) mapped at 0x70000000 by the bootloader.
# The internal CodeFlash only holds the bootloader.

# MCU class and specific type
MCU CH32H417xx CH32H417xx

# crystal frequency
OSCILLATOR_HZ 25000000

# USB setup (provisional IDs, replace with CCH assigned ones)
USB_VENDOR 0x3162 # ONLY FOR USE BY Holybro, FIXME: provisional
USB_PRODUCT 0x0053 # FIXME: provisional

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID TARGET_HW_CCH_V6C

# disable uploading bootloader while one does not exist yet
define AP_BOOTLOADER_FLASHING_ENABLED 0

# internal CodeFlash, 960KB in DBMODE=1; only the bootloader lives there.
# The app is built to run entirely from external QSPI flash.
FLASH_RESERVE_START_KB 0
FLASH_SIZE_KB 960

# External flash (QSPI2 mapped window @0x70000000); internal CodeFlash is
# not used for the application (only the bootloader).
EXT_FLASH_SIZE_MB 4

# the application runs in place from external flash; HAL_XIP_ENABLED is
# generated by chibios_hwdef.py from the QUADSPI pins below

# FIXME(CH32): CMSIS-DSP is Cortex specific; disable FFT until the
# RISC-V port of the DJ library is available
define HAL_GYROFFT_ENABLED 0

# ChibiOS system timer (TIM10: 32-bit counter, unused by PWM/GPT/ICU)
CH32_ST_USE_TIMER 10

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART7 USART5 USART1 USART4 USART2

# I2C buses, in external device enumeration order
I2C_ORDER I2C1 I2C3 I2C4

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT

# pins for SWD debugging
PB8 SWDIO SWD
PB9 SWCLK SWD

# telem1
PC12 USART7_TX USART7 SPEED_HIGH
PD2  USART7_RX USART7 SPEED_HIGH
PC8  USART7_RTS USART7 SPEED_HIGH LOW PULLDOWN
PC9  USART7_CTS USART7 SPEED_HIGH

# telem2
PE3 USART5_TX USART5 SPEED_HIGH
PF5 USART5_RX USART5 SPEED_HIGH
PD7 USART5_RTS USART5 SPEED_HIGH LOW PULLDOWN
PE1 USART5_CTS USART5 SPEED_HIGH

# GPS1
PD13 USART1_TX USART1 SPEED_HIGH
PB15 USART1_RX USART1 SPEED_HIGH

# GPS2
PC6 USART4_TX USART4 SPEED_HIGH
PF3 USART4_RX USART4 SPEED_HIGH

# telem3; not exposed as a serial port
PD5 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH

# ADC
PA1 BATT_CURRENT_SENS ADC1 SCALE(1)
PA2 BATT2_CURRENT_SENS ADC1 SCALE(1)
PA4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PB1 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
PC0 VDD_5V_SENS ADC1 SCALE(2)
PC4 HW_REV_SENSE ADC1 SCALE(1)
PC5 HW_VER_SENSE ADC1 SCALE(1)

define HAL_BATT_VOLT_PIN 4
define HAL_BATT_CURR_PIN 1
define HAL_BATT_VOLT_SCALE 18.18
define HAL_BATT_CURR_SCALE 36.36

define HAL_BATT2_VOLT_PIN 5
define HAL_BATT2_CURR_PIN 6
define HAL_BATT2_VOLT_SCALE 18.18
define HAL_BATT2_CURR_SCALE 36.36

# SPI1 - IMUs
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC15 BMI055_A_CS CS
PC14 BMI055_G_CS CS
PC13 ICM42688_CS CS
PF11 BMI055_DRDY_A INPUT
PF14 BMI055_DRDY_G INPUT
PD12 ICM42688_DRDY INPUT

# SPI4 - FRAM
PE12 SPI4_SCK SPI4 SPEED_LOW
PE5 SPI4_MISO SPI4 SPEED_LOW
PE6 SPI4_MOSI SPI4 SPEED_LOW
PD4 FRAM_CS CS

# I2C1 GPS1, shared with mag
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C3 GPS2, shared with mag
PA14 I2C3_SCL I2C3
PA13 I2C3_SDA I2C3

# I2C4 spare
PF12 I2C4_SCL I2C4
PF13 I2C4_SDA I2C4

# PWM output pins
PA8  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)
PD14 TIM4_CH3 TIM4 PWM(5) GPIO(54)
PD15 TIM4_CH4 TIM4 PWM(6) GPIO(55)
PA0  TIM5_CH1 TIM5 PWM(7) GPIO(56)
PB0  TIM5_CH4 TIM5 PWM(8) GPIO(57)

# heater PWM
PE4 TIM4_CH2 TIM4 GPIO(80) ALARM

# buzzer
PD3 TIM3_CH1 TIM3 GPIO(77) ALARM

# CAN1 (default CAN bus)
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
# CAN3 (second CAN bus)
PF4 CAN3_RX CAN3
PF7 CAN3_TX CAN3

# microSD support
PB11 SDIO_CK SDIO
PB10 SDIO_CMD SDIO
PE8  SDIO_D0 SDIO
PE9  SDIO_D1 SDIO
PB3  SDIO_D2 SDIO
PB4  SDIO_D3 SDIO
define FATFS_HAL_DEVICE SDCD1

# QSPI2 - external flash carrying the app image, XIP window at
# 0x70000000 owned by the bootloader. The pins must be defined here even
# though the application never touches the controller: __early_init() ->
# ch32_gpio_init() writes the whole VAL_GPIOx_* register tables and the
# AFIO AF mux tables generated from this hwdef, which would drop the
# bootloader's QSPI pin configuration (we execute from the XIP window).
# SPEED_HIGH so the pin output driver is in the 50MHz class
# (fork PAL ALTERNATE_PUSHPULL == nibble 0xB)
PF6  QSPI2_SCK QUADSPI2 SPEED_HIGH
PF1  QSPI2_SCSN QUADSPI2 SPEED_HIGH
PF2  QSPI2_SIO0 QUADSPI2 SPEED_HIGH
PF9  QSPI2_SIO1 QUADSPI2 SPEED_HIGH
PF10 QSPI2_SIO2 QUADSPI2 SPEED_HIGH
PE15 QSPI2_SIO3 QUADSPI2 SPEED_HIGH

# QSPI2 XIP group: the SCSXN/SIOX0..3 pins are the QSPI hardware's
# memory-mapped (XIP) transaction set, enabled via QULDSPI_CR_SIOXEN when
# the app window is mapped. The nibble AF values differ from the main
# group (AF10/AF11) - each is its own per-pin AF as the datasheet says
PC1  QSPI2_SCSXN QUADSPI2 SPEED_HIGH
PC2  QSPI2_SIOX0 QUADSPI2 SPEED_HIGH
PC3  QSPI2_SIOX1 QUADSPI2 SPEED_HIGH
PB13 QSPI2_SIOX2 QUADSPI2 SPEED_HIGH
PB14 QSPI2_SIOX3 QUADSPI2 SPEED_HIGH

# LEDs
PD10 LED_RED OUTPUT OPENDRAIN GPIO(90) LOW
PD11 LED_BLUE OUTPUT OPENDRAIN GPIO(92) LOW

# setup for BoardLED2
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 92

# power control
PB2  VDD_3V3_SENSORS_EN OUTPUT LOW
PE2  nVDD_5V_PERIPH_EN OUTPUT LOW
PD6  nVDD_5V_HIPOWER_EN OUTPUT LOW
PC7  VDD_5V_HIPOWER_nOC INPUT PULLUP
PF8  VDD_5V_PERIPH_nOC INPUT PULLUP
PE7  nUSB_VBUS_VALID INPUT PULLUP
PA15 VDD_BRICK_nVALID INPUT PULLUP
PB12 VDD_BRICK2_nVALID INPUT PULLUP
PE10 HW_VER_REV_DRIVE OUTPUT LOW

# SPI devices
SPIDEV bmi055_g SPI1 DEVID1  BMI055_G_CS  MODE3 10*MHZ 10*MHZ
SPIDEV bmi055_a SPI1 DEVID2  BMI055_A_CS  MODE3 10*MHZ 10*MHZ
SPIDEV icm42688 SPI1 DEVID3  ICM42688_CS  MODE3  2*MHZ  8*MHZ
SPIDEV ramtron  SPI4 DEVID1  FRAM_CS      MODE3  8*MHZ  8*MHZ

# IMUs
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180_YAW_90
IMU BMI055 SPI:bmi055_a SPI:bmi055_g ROTATION_PITCH_180

# enable RAMTRON parameter storage
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

DMA_PRIORITY ADC* SPI* USART* SDIO* I2C*

# enable FAT filesystem support (needs a microSD defined via SDIO)
define HAL_OS_FATFS_IO 1


MAIN_STACK 0x2000
PROCESS_STACK 0x6000
