# hw definition file for processing by chibios_hwdef.py
# for the CCH-v6c hardware (WCH CH32H417, Pixhawk v6C-compatible layout)
#
# NOTE: the application firmware runs in place from the internal CodeFlash
# (zero wait states).  The V5F app window is 0x00010000..0x000F0000 (896K);
# QSPI2 is no longer used by the flight image and is kept only as a
# bootloader-side flashing target.

# MCU class and specific type
MCU CH32H417xx CH32H417xx

# crystal frequency
OSCILLATOR_HZ 25000000

# USB setup (provisional IDs, replace with CCH assigned ones)
USB_VENDOR 0x3162 # ONLY FOR USE BY Holybro, FIXME: provisional
USB_PRODUCT 0x0053 # FIXME: provisional

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID TARGET_HW_CCH_V6C

# disable uploading bootloader while one does not exist yet
define AP_BOOTLOADER_FLASHING_ENABLED 0

# internal CodeFlash, 960KB in DBMODE=1; only the bootloader lives there.
# The app is built to run entirely from external QSPI flash.
FLASH_SIZE_KB 960
FLASH_RESERVE_START_KB 0


# Real flash support: the app image lives in (and is updated in) the
# internal CodeFlash, so hwdef/common/flash_ch32.c wraps the ChibiOS EFL
# lld (modules/ChibiOS/os/hal/ports/WCH/CH32H417).  The lld is pointed at
# the whole 960K CodeFlash instead of its default 128K storage partition;
# page granularity (4K/8K) follows FLASH_CFGR0.DBMODE and is detected at
# runtime.  Parameters stay in the SPI FRAM; no flash storage page is
# reserved.  HAL_NO_FLASH_SUPPORT is deliberately NOT defined.
define HAL_USE_EFL TRUE
define CH32H417_EFL_USE_EFL1 TRUE
define CH32H417_EFL_BASE_ADDR 0x08000000
define CH32H417_EFL_SIZE 0xF0000

# the application runs in place from external flash; HAL_XIP_ENABLED is
# generated by chibios_hwdef.py from the QUADSPI pins below

# FIXME(CH32): CMSIS-DSP is Cortex specific; disable FFT until the
# RISC-V port of the DJ library is available
define HAL_GYROFFT_ENABLED 0

# EKF/EKF3 in single precision, same choice as SPRacingH7: the V5F is a
# RV32 core with no FPU for doubles, double-precision EKF maths is
# emulated in software.  Halves the EKF state memory and its .sram_init
# footprint.
define HAL_WITH_EKF_DOUBLE 0
# 2026-11-21: default (MEM_CLASS_500) is 80KB of heap for the logger file
# write buffer, allocated in AP_Vehicle::init_ardupilot() BEFORE ins.init -
# it starved the IMU backend allocation once the code-relocation batches
# shrank the heap below ~100K ("INS: unable to initialise driver").  32KB
# frees 48KB of heap to fund the SRAM/ITCM code migration.
define HAL_LOGGING_FILE_BUFSIZE 32

# The QingKe V5F has a single-precision hardware FPU (rv32imafc).  __FPU_PRESENT
# is an attribute of the chip, so it is defined in hwdef/common/
# ch32_stm32_compat.h rather than here: hwdef.dat only feeds the application
# image, and the bootloader build (hwdef-bl.dat) needs it as well.

# GCS_CrashTrigger.cpp's developer-only "interrupt storm" test writes
# STM32H7 EXTI registers (SWIER1/RTSR1/FTSR1/IMR1/EMR1).  CH32's EXTI
# uses a different register set (SWIEVR/RTENR/FTENR/INTENR/INTFR), and
# this board has crash dumps disabled anyway, so don't build that test.
define AP_MAVLINK_FAILURE_CREATION_ENABLED 0

# ChibiOS system timer: adapt-417's hal_st_lld only accepts TIM2..TIM5.
# TIM2 is free on this board (PWM uses TIM1/3/4/5).  The define lives in
# hwdef/common/ch32h417_mcuconf.h (CH32H417_ST_USE_TIMER 2).

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART7 USART5 USART1 USART4 USART2

# I2C buses, in external device enumeration order
I2C_ORDER I2C1 I2C3 I2C4

# USB. The pads are deliberately left at their reset state (input,
# floating): the CH32H417 USBFS PHY drives PA11/PA12 directly, labelling
# them with the OTG_FS_* mux names pulls them onto the AF0 digital path
# (PIN_MODE_ALTERNATE) instead and enumeration dies. This matches the
# vendor EVT USBFS device examples ("PA11/PA12 need nothing but the port
# clock").
PA11 USB_DM OTG1
PA12 USB_DP OTG1
PA9 VBUS INPUT

# pins for SWD debugging
PB8 SWDIO SWD
PB9 SWCLK SWD

# telem1
PC12 USART7_TX USART7 SPEED_HIGH
PD2  USART7_RX USART7 SPEED_HIGH
PC8  USART7_RTS USART7 SPEED_HIGH LOW PULLDOWN
PC9  USART7_CTS USART7 SPEED_HIGH

# telem2
PE3 USART5_TX USART5 SPEED_HIGH
PF5 USART5_RX USART5 SPEED_HIGH
PD7 USART5_RTS USART5 SPEED_HIGH LOW PULLDOWN
PE1 USART5_CTS USART5 SPEED_HIGH

# GPS1
PD13 USART1_TX USART1 SPEED_HIGH
PB15 USART1_RX USART1 SPEED_HIGH

# GPS2
PC6 USART4_TX USART4 SPEED_HIGH
PF3 USART4_RX USART4 SPEED_HIGH

# telem3; not exposed as a serial port
PD5 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH

# debug serial (USART3)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# ADC
PA1 BATT_CURRENT_SENS ADC1 SCALE(1)
PA2 BATT2_CURRENT_SENS ADC1 SCALE(1)
PA4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PB1 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
PC0 VDD_5V_SENS ADC1 SCALE(2)
PC4 HW_REV_SENSE ADC1 SCALE(1)
PC5 HW_VER_SENSE ADC1 SCALE(1)

define HAL_BATT_VOLT_PIN 4
define HAL_BATT_CURR_PIN 1
define HAL_BATT_VOLT_SCALE 18.18
define HAL_BATT_CURR_SCALE 36.36

define HAL_BATT2_VOLT_PIN 5
define HAL_BATT2_CURR_PIN 6
define HAL_BATT2_VOLT_SCALE 18.18
define HAL_BATT2_CURR_SCALE 36.36

# SPI1 - IMUs
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC15 BMI055_A_CS CS
PC14 BMI055_G_CS CS
PC13 ICM42688_CS CS
PF11 BMI055_DRDY_A INPUT
PF14 BMI055_DRDY_G INPUT
PD12 ICM42688_DRDY INPUT

# SPI4 - FRAM
PE12 SPI4_SCK SPI4 SPEED_LOW
PE5 SPI4_MISO SPI4 SPEED_LOW
PE6 SPI4_MOSI SPI4 SPEED_LOW
PD4 FRAM_CS CS

# I2C1 GPS1, shared with mag
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C3 GPS2, shared with mag
PA14 I2C3_SCL I2C3
PA13 I2C3_SDA I2C3

# I2C4 spare
PF12 I2C4_SCL I2C4
PF13 I2C4_SDA I2C4

# PWM output pins
PA8  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)
PD14 TIM4_CH3 TIM4 PWM(5) GPIO(54)
PD15 TIM4_CH4 TIM4 PWM(6) GPIO(55)
PA0  TIM5_CH1 TIM5 PWM(7) GPIO(56)
PB0  TIM5_CH4 TIM5 PWM(8) GPIO(57)

# heater PWM
PE4 TIM4_CH2 TIM4 GPIO(80) ALARM

# buzzer
PD3 TIM3_CH1 TIM3 GPIO(77) ALARM

# CAN1 (default CAN bus)
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
# CAN3 (second CAN bus)
PF4 CAN3_RX CAN3
PF7 CAN3_TX CAN3

# microSD support
PB11 SDIO_CK SDIO
PB10 SDIO_CMD SDIO
PE8  SDIO_D0 SDIO
PE9  SDIO_D1 SDIO
PB3  SDIO_D2 SDIO
PB4  SDIO_D3 SDIO
define FATFS_HAL_DEVICE SDCD1


# LEDs
PD10 LED_RED OUTPUT OPENDRAIN GPIO(90) LOW
PD11 LED_BLUE OUTPUT OPENDRAIN GPIO(92) LOW

# setup for BoardLED2
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 92

# power control
PB2  VDD_3V3_SENSORS_EN OUTPUT LOW
PE2  nVDD_5V_PERIPH_EN OUTPUT LOW
PD6  nVDD_5V_HIPOWER_EN OUTPUT LOW
PC7  VDD_5V_HIPOWER_nOC INPUT PULLUP
PF8  VDD_5V_PERIPH_nOC INPUT PULLUP
PE7  nUSB_VBUS_VALID INPUT PULLUP
PA15 VDD_BRICK_nVALID INPUT PULLUP
PB12 VDD_BRICK2_nVALID INPUT PULLUP
PE10 HW_VER_REV_DRIVE OUTPUT LOW

# SPI devices
SPIDEV bmi055_g SPI1 DEVID1  BMI055_G_CS  MODE3 10*MHZ 10*MHZ
SPIDEV bmi055_a SPI1 DEVID2  BMI055_A_CS  MODE3 10*MHZ 10*MHZ
SPIDEV icm42688 SPI1 DEVID3  ICM42688_CS  MODE3  2*MHZ  8*MHZ
SPIDEV ramtron  SPI4 DEVID1  FRAM_CS      MODE3  8*MHZ  8*MHZ

# IMUs
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180_YAW_90
IMU BMI055 SPI:bmi055_a SPI:bmi055_g ROTATION_PITCH_180

# compass
define AP_COMPASS_PROBING_ENABLED 1
COMPASS IST8310 I2C:2:0x0C false ROTATION_NONE

# barometers
BARO MS5611 I2C:2:0x76
BARO MS5611 I2C:2:0x77

# enable RAMTRON parameter storage
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

DMA_PRIORITY ADC* SPI* USART* SDIO* I2C*

# enable FAT filesystem support (needs a microSD defined via SDIO)
define HAL_OS_FATFS_IO 1


MAIN_STACK 0x4000
PROCESS_STACK 0x6000

define AP_WATCHDOG_SAVE_FAULT_ENABLED 0

STDOUT_SERIAL SD3
STDOUT_BAUDRATE 115200

# internal-CodeFlash layout: the app XIPs from 0x0000F000, so cache the
# CODE_AREA window (0x00000000-0x1FFFFFFF) and keep the MEM0 (QSPI XIP)
# window off.
define PORT_RISCV_ICACHE_MEM0_AREA FALSE
define PORT_RISCV_ICACHE_CODE_AREA TRUE

define CH_DBG_STACK_CHECKS TRUE


define HAL_BARO_ALLOW_INIT_NO_BARO
define DISABLE_WATCHDOG TRUE
define SCHED_LOOP_RATE 200

# ---- flash fit trimming ----------------------------------------------------
# The 896K CodeFlash window is tight; these disable optional peripherals and
# flight modes.  Each is a standard ArduPilot config macro, re-enable by
# deleting the line (and re-checking the size check at link time).
include ../include/minimize_features.inc

define AP_RANGEFINDER_ENABLED 0      // 测距雷达/激光，不用雷达必关
define AP_FENCE_ENABLED 0            // 电子围栏，室内台架测试优先关；室外飞行如果不用围栏也可以关
define AC_PRECLAND_ENABLED 0         // 精准降落，不用精准降落直接砍
define AP_FOLLOW_ENABLED 0
define HAL_RALLY_ENABLED 0           // 航点返航点（备用集结点），只用HOME点可以关
define HAL_PARACHUTE_ENABLED 0       // 降落伞驱动，无降落伞必关
define HAL_SPEKTRUM_TELEM_ENABLED 0  // Spektrum遥测，不用Spektrum遥测
define HAL_SUPPORT_RCOUT_SERIAL 0    // RCout串口协议，你一般DroneCAN输出，不用
define MODE_SYSTEMID_ENABLED 0       // SystemID系统辨识
define MODE_AUTOROTATE_ENABLED 0     // 直升机自转，Copter固定翼无关，直接关
# define MODE_TURTLE_ENABLED 0         // 翻机模式，不用可以关
define MODE_ZIGZAG_ENABLED 0         // 锯齿航线模式
define MODE_THROW_ENABLED 0          // 抛飞模式
define MODE_SMARTRTL_ENABLED 0
define AP_GPS_ERB_ENABLED 0
define AP_GPS_GSOF_ENABLED 0
define AP_GPS_NOVA_ENABLED 0
define AP_GPS_SBF_ENABLED 0
define AP_GPS_SBP_ENABLED 0
define AP_GPS_SBP2_ENABLED 0
define AP_GPS_SIRF_ENABLED 0
define AP_GPS_MAV_ENABLED 0
define AP_GPS_BLENDED_ENABLED 0      // GPS协议：只保留你实际在用的GPS（比如Ublox），其余全部关掉，收益不小
define HAL_MOUNT_ENABLED 0           // 云台/吊舱驱动，无云台必关
define OSD_ENABLED 0                 // 图传OSD字符叠加，不用就关
define HAL_CRSF_TELEM_ENABLED 0      // CRSF遥测，不用黑羊遥测
define AP_FRSKY_TELEM_ENABLED 0      // FrSky遥测
define HAL_MSP_ENABLED 0              // MSP协议（BF/INAV协议互通），不用；OSD已关，MSP DisplayPort会引用被裁掉的AP_OSD成员
define AP_OPTICALFLOW_ENABLED 0      // 光流传感器，无光流必关
define AP_CAMERA_ENABLED 0           // 相机快门、拍照录像控制
define AP_TERRAIN_AVAILABLE 0        // 地形跟随（地形数据库），不用地形跟随就关
define AUTOTUNE_ENABLED 0            // 自动调参，你手动调PID，这个体积大户非常推荐关掉！体积削减很明显
