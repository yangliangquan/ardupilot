# hw definition file for processing by chibios_hwdef.py
# for the CCH-v6c hardware (WCH CH32H417, Pixhawk v6C-compatible layout)
# BOOTLOADER build: runs from internal CodeFlash (0x00001000..0x00010000)
# and programs the flight image into the app-image NOR flash on QSPI2.
# EXT_FLASH_SIZE_MB below makes the script emit BOOT_FROM_EXT_FLASH and
# point APP_START_ADDRESS at the QSPI XIP window (0x70000000).

# MCU class and specific type
MCU CH32H417xx CH32H417xx

# crystal frequency
OSCILLATOR_HZ 25000000

# USB setup (provisional IDs, replace with CCH assigned ones)
USB_VENDOR 0x3162 # ONLY FOR USE BY Holybro, FIXME: provisional
USB_PRODUCT 0x0053 # FIXME: provisional

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID TARGET_HW_CCH_V6C

# The 4K V3 stub before the bootloader is already accounted for by
# FLASH_BASE (0x00001000) in CH32H417xx.py: it drives both the bootloader
# ldscript org and FLASH_LOAD_ADDRESS.  FLASH_RESERVE_START_KB must stay 0
# here or APP_START_ADDRESS would double-count the stub and land at
# 0x00011000 instead of the app link address 0x00010000.
FLASH_RESERVE_START_KB 0

# the bootloader image budget in internal CodeFlash.  write_ch32_ldscript
# derives the app window from FLASH_BASE (0x00001000) +
# FLASH_BOOTLOADER_MAX_KB (60 in CH32H417xx.py), so the app is linked at
# 0x00010000 and APP_START_ADDRESS (= FLASH_LOAD_ADDRESS +
# FLASH_BOOTLOADER_LOAD_KB) must stay consistent with that.
FLASH_BOOTLOADER_LOAD_KB 60

APP_START_OFFSET_KB 0

# internal CodeFlash, 960KB in DBMODE=1
FLASH_SIZE_KB 960

# the bootloader programs the whole CodeFlash through the ChibiOS EFL lld
# (wrapped by hwdef/common/flash_ch32.c): page granularity (4K/8K) follows
# FLASH_CFGR0.DBMODE and is detected at runtime
define HAL_USE_EFL TRUE
define CH32H417_EFL_USE_EFL1 TRUE
define CH32H417_EFL_BASE_ADDR 0x08000000
define CH32H417_EFL_SIZE 0xF0000

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART3

# USB. The pads are deliberately left at their reset state (input,
# floating): the CH32H417 USBFS PHY drives PA11/PA12 directly, labelling
# them with the OTG_FS_* mux names pulls them onto the AF0 digital path
# (PIN_MODE_ALTERNATE) instead and enumeration dies. This matches the
# vendor EVT USBFS device examples ("PA11/PA12 need nothing but the port
# clock").
PA11 USB_DM OTG1
PA12 USB_DP OTG1
PA9 VBUS INPUT

# debug serial (USART3)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# pins for SWD debugging
PB8 SWDIO SWD
PB9 SWCLK SWD

# QSPI2 (Winbond flash, app image target). SPEED_HIGH so the pin output
# driver is in the 50MHz class (fork PAL ALTERNATE_PUSHPULL == nibble 0xB)
PF6  QUADSPI2_SCK QUADSPI2 SPEED_HIGH
PF1  QUADSPI2_SCSN QUADSPI2 SPEED_HIGH
PF2  QUADSPI2_SIO0 QUADSPI2 SPEED_HIGH
PF9  QUADSPI2_SIO1 QUADSPI2 SPEED_HIGH
PF10 QUADSPI2_SIO2 QUADSPI2 SPEED_HIGH
PE15 QUADSPI2_SIO3 QUADSPI2 SPEED_HIGH

# QSPI2 XIP group: the SCSXN/SIOX0..3 pins are the QSPI hardware's
# memory-mapped (XIP) transaction set, enabled via QULDSPI_CR_SIOXEN when
# the app window is mapped. The nibble AF values differ from the main
# group (AF10/AF11) - each is its own per-pin AF as the datasheet says
PC1  QUADSPI2_SCSXN QUADSPI2 SPEED_HIGH
PC2  QUADSPI2_SIOX0 QUADSPI2 SPEED_HIGH
PC3  QUADSPI2_SIOX1 QUADSPI2 SPEED_HIGH
PB13 QUADSPI2_SIOX2 QUADSPI2 SPEED_HIGH
PB14 QUADSPI2_SIOX3 QUADSPI2 SPEED_HIGH

# the app-image NOR flash on QSPI2 (32Mbit => 4MB, size as power of 2 = 22)
QSPIDEV w25q QUADSPI2 MODE3 100*MHZ 22 0

# app image lives in the QSPI NOR: this is the trigger for the script to
# generate BOOT_FROM_EXT_FLASH and the external APP_START_ADDRESS
EXT_FLASH_SIZE_MB 4
EXT_FLASH_RESERVE_START_KB 0
EXT_FLASH_RESERVE_END_KB 0

# LEDs
PD10 LED_ACTIVITY OUTPUT OPENDRAIN GPIO(90) HIGH # red
PD11 LED_BOOTLOADER OUTPUT OPENDRAIN GPIO(92) HIGH # blue
define HAL_LED_ON 0

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384

# no SD-card flashing on this board (app lives in external QSPI)
define AP_BOOTLOADER_FLASH_FROM_SD_ENABLED 0

# FATFS not needed in the bootloader
define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1

define BOOTLOADER_DEBUG SD3
define SERIAL_USB_BUFFERS_NUMBER 8

define AP_FASTBOOT_ENABLED 0
# define HAL_ENABLE_VBUS_CHECK 1